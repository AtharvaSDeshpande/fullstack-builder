  "project": {
    "name": "ShopOrders",
    "slug": "shop-orders",
    "type": "ecommerce",
    "tagline": "Restock your shop in a few taps",
    "summary": "A B2B ordering web app where small neighbourhood shop owners in India restock from distributors. Owners reorder similar items every week or two, so repeat ordering and search must be fast."
  },
  "business": {
    "problem": "Shop owners reorder from distributors by phone call or message, which is slow and error-prone.",
    "why_now": "Demo project to show the full build pipeline.",
    "goals": [
      "Let a shop owner place a repeat order in a few taps",
      "Show a complete ordering flow with mock data"
    ],
    "success_metrics": [
      {
        "metric": "Time to place a repeat order",
        "target": "set after baseline",
        "baseline": "unknown",
        "how_measured": "usability session on a 360px phone"
      }
    ],
    "business_model": "Distributors pay per order or subscription (not decided; no payments in this build).",
    "stakeholders": [
      {
        "role": "Product owner",
        "decides": "scope and sign-off"
      }
    ],
    "competitors": [
      {
        "name": "none reviewed",
        "note": "no competitor claims are made in this build"
      }
    ],
    "differentiators": [
      "Hindi, English and Marathi",
      "Repeat ordering first",
      "Works on low-end phones"
    ],
    "launch": {
      "target_date": "none",
      "type": "pilot"
    },
    "budget": {
      "range": "not set",
      "notes": ""
    }
  },
  "audience": {
    "primary_users": "Small shop owners",
    "devices": [
      "low-end Android phone",
      "desktop"
    ],
    "network": "patchy 3G/4G with low data balance",
    "notes": "Mixed literacy. Many prefer Hindi or Marathi over English. They reorder similar items every week or two.",
    "personas": [
      {
        "id": "shop-owner",
        "name": "Store owner",
        "description": "Runs a small neighbourhood grocery store and restocks every week or two.",
        "goals": [
          "Restock quickly",
          "Avoid running out of fast-moving items"
        ],
        "pain_points": [
          "Slow phone and patchy data",
          "Typing English product names"
        ],
        "tech_comfort": "low",
        "devices": [
          "low-end Android phone"
        ],
        "languages": [
          "hi",
          "mr",
          "en"
        ],
        "usage_frequency": "weekly"
      }
