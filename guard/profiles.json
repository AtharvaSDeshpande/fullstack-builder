{
 "_note": "Single source of truth for what every agent may do. Paths are relative to the project folder; '@root/' means the session root; '{run}' is the active run folder. Edit this file, then re-run setup.mjs install. Agents cannot edit it.",
 "max_agent_calls_default": 25,
 "passthrough_tools": ["TodoWrite", "Skill", "AskUserQuestion", "ToolSearch", "EnterPlanMode", "ExitPlanMode"],
 "protected": [
  "@root/.fullstack-builder/",
  "@root/.claude/",
  "@root/.codex/",
  "@root/.gemini/",
  "@root/.agents/",
  "@root/.cursor/",
  "@root/.git/",
  "@root/site.spec.json",
  "@root/site.spec.md",
  "@root/site.spec.normalized.json",
  ".git/",
  "docs/spec.lock.json",
  "docs/runs/CURRENT",
  "docs/runs/INDEX.md",
  "docs/runs/*/spawns.log",
  "docs/runs/*/guard-log.jsonl",
  "docs/runs/*/canary.ok",
  "docs/runs/*/tier.json",
  "docs/runs/*/waves.json",
  "docs/runs/*/wave-state.json",
  "docs/runs/*/bus/receipts/"
 ],
 "profiles": {
  "pm": {
   "role": "Master Product Manager",
   "job": "Plan, brief agents, log, hand the decision to the human",
   "tools": "*",
   "read_skill": true,
   "write": [
    "docs/CONTRACTS.md",
    "docs/TRACEABILITY.md",
    "docs/spec.lock.json",
    "docs/runs/{run}/",
    "@root/site.spec.normalized.json"
   ],
   "bash": [
    "pm-scripts",
    "project-checks",
    "run-app",
    "install-deps",
    "readonly-git",
    "npm-view"
   ]
  },
  "guard-canary": {
   "role": "Guard canary",
   "job": "Prove the guard works. The PM briefs the exact probes",
   "tools": [
    "Read",
    "Write",
    "Bash"
   ],
   "write": [
    "docs/runs/{run}/agents/canary-allowed.txt"
   ],
   "bash": []
  },
  "a1-architect": {
   "role": "Senior front-end architect",
   "job": "Scaffold, folder structure, build and lint config, performance, contracts",
   "tools": [
    "Read",
    "Grep",
    "Glob",
    "Write",
    "Edit",
    "Bash"
   ],
   "write": [
    "package.json",
    "package-lock.json",
    "vite.config.js",
    "vitest.config.js",
    "index.html",
    "eslint.config.js",
    ".eslintrc.cjs",
    ".prettierrc",
    ".prettierignore",
    ".gitignore",
    "README.md",
    "public/vite.svg",
    "src/main.jsx",
    "src/App.jsx",
    "src/index.css",
    "src/App.css",
    "src/assets/",
    "src/app/",
    "src/routes/",
    "src/test/setup.js",
    "docs/CONTRACTS.md"
   ],
   "bash": [
    "architect-setup",
    "install-deps",
    "project-checks",
    "readonly-git",
    "npm-view"
   ],
   "waves": [
    1
   ]
  },
  "a2-designer": {
   "role": "Mobile-first UX/UI designer",
